macro primary_instr_r8_r8(code) {
    [gpr8 a, gpr8 b] = {
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = 0,
        [2-2] = b[3-3],
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GExtend || b in GExtend);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = b,
        [2-0] = a
      };
    }
}

macro primary_instr_rv_rv(code) {
    [Gv a, Gv b] = {
      @ ( #a == #b );
      osoPrefix: [8] = 0x66 @ (#a == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#a == 64) ?  1 : 0,
        [2-2] = b[3-3],
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GREX || b in GREX);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = b,
        [2-0] = a
      };
    }
}

macro primary_instr_m8_r8(code) {
    [REFb a, gpr8 b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = 0,
        [2-2] = b[3-3],
        [1-1] = 0,
        [0-0] = a.reg[3-3]
      } @ (a.reg in GREX || b in GREX);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = b,
        [2-0] = a.reg
      };
    }
}

macro primary_instr_mv_rv(code) {
    [REFv a, Gv b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      osoPrefix: [8] = 0x66 @ (b in gpr16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#b == 64) ?  1 : 0,
        [2-2] = b[3-3],
        [1-1] = 0,
        [0-0] = a.reg[3-3]
      } @ (a.reg in GExtend || b in GREX);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = b,
        [2-0] = a.reg
      };
    }
}

macro primary_instr_r8_m8(code) {
    [gpr8 a, REFb b] = {
      asoPrefix: [8] = 0x67 @ (b.reg in gpr32);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = 0,
        [2-2] = a[3-3],
        [1-1] = 0,
        [0-0] = b.reg[3-3]
      } @ (a in GREX || a in gpr8s || b.reg in GExtend);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = a,
        [2-0] = b.reg
      };
    }
    [gpr8h a, REFb b] = {
      asoPrefix: [8] = 0x67 @ (b.reg in gpr32);
      REX: [8] = {
        [7-4] = 0x4,
        [3-1] = 0,
        [0-0] = b.reg[3-3]
      } @ (b.reg in GExtend);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = a,
        [2-0] = b.reg
      };
    }
}
macro primary_instr_rv_mv(code) {
    [Gv a, REFv b] = {
      asoPrefix: [8] = 0x67 @ (b.reg in gpr32);
      osoPrefix: [8] = 0x66 @ (a in gpr16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#a == 64) ?  1 : 0,
        [2-2] = a[3-3],
        [1-1] = 0,
        [0-0] = b.reg[3-3]
      } @ (a in GREX || b.reg in GExtend);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = a,
        [2-0] = b.reg
      };
    }
}

macro primary_instr(name, code) {
  instruction name {
    primary_instr_r8_r8(code)
    primary_instr_rv_rv({code + 1})
    primary_instr_m8_r8(code)
    primary_instr_mv_rv({code + 1})
  }
}
macro primary_instr_rev(name, code) {
  instruction name {
    primary_instr_r8_r8(code)
    primary_instr_rv_rv({code + 1})
    primary_instr_r8_m8(code)
    primary_instr_rv_mv({code + 1})
  }
}

macro primary_instr_imm(name, code, gpr1_id) {
  instruction name {
    [Ib a] = {
      opcode: [8] = code;
      imm: [8] = a;
    }
    [Id a] = {
      opcode: [8] = code + 1;
      imm: [32] = a;
    }
    [gpr8 a, Ib b] = {
      REX: [8] = 0x41 @ (a in gpr8Extend);
      opcode: [8] = 0x80;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = gpr1_id,
        [2-0] = a
      };
      imm: [8] = b;
    }
    [REFb a, Ib b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = 41 @ (a.reg in GREX);
      opcode: [8] = 0x80;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = gpr1_id,
        [2-0] = a.reg
      };
      imm: [8] = b;
    }
    [Gv a, Iz b] = {
      @ (#a == #b);
      osoPrefix: [8] = 0x66 @ (a in gpr16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (a in gpr64) ? 1 : 0,
        [2-2] = 0,
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GREX);
      opcode: [8] = 0x81;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = gpr1_id,
        [2-0] = a
      };
      imm: [?] = b;
    }
    [REFv a, I b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = 0x41 @ (a.reg in GExtend);
      opcode: [8] = 0x81;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = gpr1_id,
        [2-0] = a.reg
      };
      imm: [?] = b;
    }
    [Gv a, Ib b] = {
      osoPrefix: [8] = 0x66 @ (a in gpr16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (a in gpr64) ? 1 : 0,
        [2-2] = 0,
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GREX);
      opcode: [8] = 0x83;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = gpr1_id,
        [2-0] = a
      };
      imm: [8] = b;
    }
    [REFv a, Ib b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = 0x41 @ (a.reg in GREX);
      opcode: [8] = 0x83;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = gpr1_id,
        [2-0] = a.reg
      };
      imm: [8] = b;
    }
  }
}

