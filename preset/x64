macro basic_general_purpose_register(name, code, extend_code) {
  register g`name`x [64-bit] {
    r`name`x: [63-0] = code;
    e`name`x: [31-0] = code;
      name`x: [15-0] = code;
      name`h: [15-8] = extend_code;
      name`l: [07-0] = code;
  }
}
macro primary_general_purpose_register(name, code) {
  register g`name [64-bit] {
    r`name: [63-0] = code;
    e`name: [31-0] = code;
      name: [15-0] = code;
    name`l: [07-0] = code;
  }
}
macro extend_general_purpose_register(name, code) {
  register g`name [64-bit] {
      name: [63-0] = code;
    name`d: [31-0] = code;
    name`w: [15-0] = code;
    name`b: [07-0] = code;
  }
}
