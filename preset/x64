macro primary_instr_rx_mv(code, type, mod, disp) {
    [Gv a, type b] = {
      asoPrefix: [8] = 0x67 @ (b.reg in gpr32 || b.reg in eip);
      osoPrefix: [8] = 0x66 @ (#a == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#a == 64) ?  1 : 0,
        [2-2] = a[3-3],
        [1-1] = 0,
        [0-0] = b.reg[3-3]
      } @ (a in GREX || b.reg in GExtend);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = mod,
        [5-3] = a,
        [2-0] = b.reg
      };
    }
}
  instruction lea {
    primary_instr_rx_mv(0x8d, PTR  , 0b00, {})
    primary_instr_rx_mv(0x8d, REL  , 0b00, { disp32: [32] = a.disp; })
    primary_instr_rx_mv(0x8d, REL8 , 0b01, { disp8: [8] = a.disp; })
    primary_instr_rx_mv(0x8d, REL32, 0b10, { disp32: [32] = a.disp; })
  }

  instruction xchg {
    primary_instr_rv_rv(0x86)
    primary_instr_mv_rv(0x86)
  }

  instruction push {
    [gpr64 a] = {
      REX: [8] = 0x41 @ (a in gpr64Extend);
      opcode: [8] = {
        [7-4] = 0x5,
        [3-3] = 0,
        [2-0] = a[0-2]
      };
    }
  }
  instruction pop {
    [gpr64 a] = {
      REX: [8] = 0x41 @ (a in gpr64Extend);
      opcode: [8] = {
        [7-4] = 0x5,
        [3-3] = 1,
        [2-0] = a[0-2]
      };
    }
  }

  instruction movabs {
    [gpr8v a, Ib b] = {
        REX: [8] = 0x41 @ (a in gpr8Extend);
        opcode: [8] = 0xb0 + (a - al) % 8;
        imm: [8] = b;
    }
    [gpr16 a, Iw b] = {
      osoPrefix: [8] = 0x66;
      REX: [8] = 0x41 @ (a in gpr16Extend);
      opcode: [8] = 0xb8 + (a - ax) % 8;
      imm: [16] = b;
    }
    [gpr32 a, Id b] = {
      REX: [8] = 0x41 @ (a in gpr32Extend);
      opcode: [8] = 0xb8 + (a - eax) % 8;
      imm: [32] = b;
    }
    [gpr64 a, Ir b] = {
      REX: [8] = (a in gpr64Extend) ? 0x49 : 0x48;
      opcode: [8] = 0xb8 + (a - rax) % 8;
      imm: [64] = b;
    }
  }
  instruction movi {
    [gpr8v a, Ib b] = {
      REX: [8] = 0x41 @ (a in gpr8Extend);
      opcode: [8] = 0xc6;
      modRM: [8] = {
        [6-7] = 0b11,
        [3-5] = a,
