macro primary_instr_rv_rv(code) {
    [Gv a, Gv b] = {
      @ ( #a == #b );
      osoPrefix: [8] = 0x66 @ (#a == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#a == 64) ?  1 : 0,
        [2-2] = b[3-3],
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GREX || b in GREX);
      opcode: [8] = (#a == 8) ? code : (code + 1);
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = b,
        [2-0] = a
      };
    }
}
macro primary_instr_mv_rv_principal(code, rel_type, mod, disp) {
    [rel_type a, Gv b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32 || a.reg in eip);
      osoPrefix: [8] = 0x66 @ (#b == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#b == 64) ?  1 : 0,
        [2-2] = b[3-3],
        [1-1] = 0,
        [0-0] = a.reg[3-3]
      } @ (a.reg in GExtend || b in GREX || b in gpr8s);
      opcode: [8] = (#b == 8) ? code : (code + 1);
      modRM: [8] = {
        [7-6] = mod,
        [5-3] = b,
        [2-0] = a.reg
      };
      disp
    }
}
macro primary_instr_mv_rv_sib(code, mod, disp) {
    [SIB a, Gv b] = {
      @(
        ((a.index in gpr32)&&(a.index in gpr32)) ||
        ((a.index in gpr64)&&(a.index in gpr64))
      );
      asoPrefix: [8] = 0x67 @ (a.base in gpr32);
      osoPrefix: [8] = 0x66 @ (#b == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#b == 64) ?  1 : 0,
        [2-2] = b[3-3],
        [1-1] = (a.base in gsp) ? 0 : a.index[3-3],
        [0-0] = (mod == 0 && a.base in gbp) ? 0 : a.base[3-3]
      } @ (a.base in GREX || b in GREX);
      opcode: [8] = (#b == 8) ? code : (code + 1);
      modRM: [8] = {
        [7-6] = mod,
        [5-3] = b,
        [2-0] = 0x4
      };
      SIB: [8] = {
        [7-6] = a.scale,
        [5-3] = (a.base in gsp) ? 0 : a.index,
        [2-0] = (mod == 0 && a.base in gbp) ? 0 : a.base
      };
      disp
    }
}
macro primary_instr_rv_mv_principal(code, type, mod, disp) {
    [Gv a, type b] = {
      asoPrefix: [8] = 0x67 @ (b.reg in gpr32 || b.reg in eip);
      osoPrefix: [8] = 0x66 @ (#a == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#a == 64) ?  1 : 0,
        [2-2] = a[3-3],
        [1-1] = 0,
        [0-0] = b.reg[3-3]
      } @ (a in GREX || b.reg in GExtend);
      opcode: [8] = (#a == 8) ? code : (code + 1);
      modRM: [8] = {
        [7-6] = mod,
        [5-3] = a,
        [2-0] = b.reg
      };
      disp
    }
    [gpr8h a, type b] = {
      asoPrefix: [8] = 0x67 @ (b.reg in gpr32 || b.reg in eip);
      osoPrefix: [8] = 0x66 @ (#a == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [...] = 0,
        [0-0] = b.reg[3-3]
      } @ (b.reg in GExtend);
      opcode: [8] = code;
      modRM: [8] = {
        [7-6] = mod,
        [5-3] = a,
        [2-0] = b.reg
      };
      disp
    }
}
macro primary_instr_rv_mv_sib(code, mod, disp) {
    [Gv a, SIB b] = {
      @(
        ((b.index in gpr32)&&(b.index in gpr32)) ||
        ((b.index in gpr64)&&(b.index in gpr64))
      );
      asoPrefix: [8] = 0x67 @ (b.base in gpr32);
      osoPrefix: [8] = 0x66 @ (#a == 16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (#a == 64) ?  1 : 0,
        [2-2] = a[3-3],
        [1-1] = (b.base in gsp) ? 0 : b.index[3-3],
        [0-0] = (mod == 0 && b.base in gbp) ? 0 : b.base[3-3]
      } @ (a in GREX || b.base in GREX);
      opcode: [8] = (#a == 8) ? code : (code + 1);
      modRM: [8] = {
        [7-6] = mod,
        [5-3] = a,
        [2-0] = 0x4
      };
      SIB: [8] = {
        [7-6] = b.scale,
        [5-3] = (b.base in gsp) ? 0 : b.index,
        [2-0] = (mod == 0 && b.base in gbp) ? 0 : b.base
      };
      disp
    }
}

macro primary_instr_mv_rv(code) {
    primary_instr_mv_rv_principal({code}, PTR  , 0b00, {})
    primary_instr_mv_rv_principal({code}, REL  , 0b00, { disp32: [32] = a.disp; })
    primary_instr_mv_rv_principal({code}, REL8 , 0b01, { disp8: [8] = a.disp; })
    primary_instr_mv_rv_principal({code}, REL32, 0b10, { disp32: [32] = a.disp; })
}

macro primary_instr_rv_mv(code) {
    primary_instr_rv_mv_principal({code}, PTR  , 0b00, {})
    primary_instr_rv_mv_principal({code}, REL  , 0b00, { disp32: [32] = b.disp; })
    primary_instr_rv_mv_principal({code}, REL8 , 0b01, { disp8: [8] = b.disp; })
    primary_instr_rv_mv_principal({code}, REL32, 0b10, { disp32: [32] = b.disp; })
}

macro primary_instr(name, code) {
  instruction name {
    primary_instr_rv_rv({code})
    primary_instr_mv_rv({code})
  }
}
macro primary_instr_rev(name, code) {
  instruction name {
    primary_instr_rv_rv({code})
    primary_instr_rv_mv({code})
  }
}

macro primary_instr_imm_ax_iz(code) {
    [Ib a] = {
      opcode: [8] = code;
      imm: [8] = a;
    }
    [Iw a] = {
      osoPrefix: [8] = 0x66;
      opcode: [8] = code + 1;
      imm: [16] = a;
    }
    [Id a] = {
      opcode: [8] = code + 1;
      imm: [32] = a;
    }
    [Ird a] = {
      REX: [8] = 0x48;
      opcode: [8] = code + 1;
      imm: [32] = a;
    }
}

macro primary_instr_imm_in_grp1(grp1_id) {
    [BYTE_PTR a, Ib b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = 0x41 @ (a.reg in GREX);
      opcode: [8] = 0x80;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = grp1_id,
        [2-0] = a.reg
      };
      imm: [8] = b;
    }
    [WORD_PTR a, Ib b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      osoPrefix: [8] = 0x66;
      REX: [8] = 0x41 @ (a.reg in GREX);
      opcode: [8] = 0x83;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = grp1_id,
        [2-0] = a.reg
      };
      imm: [8] = b;
    }
    [DWORD_PTR a, Ib b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = 0x41 @ (a.reg in GREX);
      opcode: [8] = 0x83;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = grp1_id,
        [2-0] = a.reg
      };
      imm: [8] = b;
    }
    [QWORD_PTR a, Ib b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = (a.reg in GREX) ? 0x49 : 0x48;
      opcode: [8] = 0x83;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = grp1_id,
        [2-0] = a.reg
      };
      imm: [8] = b;
    }
    [Gv a, Iv b] = {
      @ (#a == #b);
      osoPrefix: [8] = 0x66 @ (a in gpr16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (a in gpr64) ? 1 : 0,
        [2-2] = 0,
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GREX);
      opcode: [8] = 0x81;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = grp1_id,
        [2-0] = a
      };
      imm: [?] = b;
    }
    [PTR a, Iz b] = {
      asoPrefix: [8] = 0x67 @ (a.reg in gpr32);
      REX: [8] = 0x41 @ (a.reg in GExtend);
      opcode: [8] = 0x81;
      modRM: [8] = {
        [7-6] = 0b00,
        [5-3] = grp1_id,
        [2-0] = a.reg
      };
      imm: [?] = b;
    }
    [Gv a, Ib b] = {
      osoPrefix: [8] = 0x66 @ (a in gpr16);
      REX: [8] = {
        [7-4] = 0x4,
        [3-3] = (a in gpr64) ? 1 : 0,
        [2-2] = 0,
        [1-1] = 0,
        [0-0] = a[3-3]
      } @ (a in GREX);
      opcode: [8] = (#a == 8) ? 0x80 : 0x83;
      modRM: [8] = {
        [7-6] = 0b11,
        [5-3] = grp1_id,
        [2-0] = a
      };
      imm: [8] = b;
    }
}

